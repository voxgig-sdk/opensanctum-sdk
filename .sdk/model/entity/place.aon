# Entity: place

main: kit: entity: place: {

  alias: field: {}

  fields: [
    {
      name: "description"
      req: false
      short: "Detailed description of the place"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the place"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "imageUrl"
      req: false
      short: "URL to an image of the place"
      type: "`$STRING`"
    }
    {
      name: "location"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "name"
      req: false
      short: "Name of the place of worship"
      type: "`$STRING`"
    }
    {
      name: "religion"
      req: false
      short: "Primary religion or faith tradition"
      type: "`$STRING`"
    }
    {
      name: "significance"
      req: false
      short: "Historical or spiritual significance"
      type: "`$STRING`"
    }
    {
      name: "type"
      req: false
      short: "Type of worship site"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "website"
      req: false
      short: "Official website URL"
      type: "`$STRING`"
    }
    {
      name: "yearEstablished"
      req: false
      short: "Year the place was established or built"
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "place"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "country"
                orig: "country"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 20
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 0
                kind: "query"
                name: "offset"
                orig: "offset"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "religion"
                orig: "religion"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "type"
                orig: "type"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/places"
          segments: [
            {
              lit: "places"
            }
          ]
          select: {
            exist: [
              "country"
              "limit"
              "offset"
              "religion"
              "type"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
